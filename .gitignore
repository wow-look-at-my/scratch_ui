node_modules/
# No lockfile is committed: ts0 is a branch dependency and every install
# resolves it to current HEAD (same as js-snippets).
package-lock.json
pnpm-lock.yaml

# The cooked bundle (generated by `ts0 build` from src/index.ts)
dist/

# Compiled build scripts (generated by `ts0 build --config ts0.scripts.json`)
dist-scripts/

# The concatenated stylesheet (generated by scripts/build-css.ts). It lands in
# src/ so the external import in src/styles.ts resolves at build time, but it
# is output, not source.
src/scratch-ui.css

# Assembled site output (generated by scripts/assemble-pages.ts)
_site/
